# Local bearer token used by the FastAPI endpoints.
USER_API_KEY="replace-with-a-local-bearer-token"

# Google AI Studio configuration.
GEMINI_API_KEY="replace-with-your-google-ai-studio-key"
DEFAULT_GOOGLE_MODEL="gemini-2.5-flash-lite"

# Evaluation settings. Increasing repeats improves the consistency estimate but
# also increases latency and model usage.
EVAL_JUDGE_MODEL="gemini-2.5-flash-lite"
EVAL_NUM_REPEATS=1

# Local service endpoints used by the Gradio client and trace exporter.
API_BASE_URL="http://localhost:8000"
PHOENIX_URL="http://127.0.0.1:6006"
